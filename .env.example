# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
WS_PORT=8765
METRICS_PORT=9090

# Database Configuration
DATABASE_URL=postgresql://matching:matching123@localhost:5432/matching_engine
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=your-secret-key-change-in-production
API_KEY=your-api-key-change-in-production

# Performance Tuning
MAX_WORKERS=4
ORDER_QUEUE_SIZE=10000
WEBSOCKET_MAX_CONNECTIONS=1000

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_NAMESPACE=matching_engine

# Feature Flags
ENABLE_MARKET_ORDERS=true
ENABLE_IOC_ORDERS=true
ENABLE_FOK_ORDERS=true
ENABLE_STOP_ORDERS=false

# Rate Limiting
RATE_LIMIT_ORDERS_PER_SECOND=100
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
