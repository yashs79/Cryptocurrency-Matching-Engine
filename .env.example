# Application Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/matching_engine
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=your-secret-key-here-change-in-production
API_KEY=your-api-key-here

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# Performance
MAX_ORDERS_PER_SECOND=5000
ORDER_BOOK_DEPTH=100

# ============================================
# DEPLOYMENT AUTOMATION CONFIGURATION
# ============================================

# Render API Configuration
# Get your API key from: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Configuration
# Create a Personal Access Token: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Repository Info (Optional - Auto-detected from git remote)
# Only set these if you want to override auto-detection
# GITHUB_USERNAME=your-github-username
# GITHUB_REPO=matching-engine

# Project Configuration
PROJECT_NAME=matching-engine
OWNER_EMAIL=your-email@example.com
WEBSOCKET_MAX_CONNECTIONS=1000

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_NAMESPACE=matching_engine
# Feature Flags
ENABLE_MARKET_ORDERS=true
ENABLE_IOC_ORDERS=true
ENABLE_FOK_ORDERS=true
ENABLE_STOP_ORDERS=false

# Rate Limiting
RATE_LIMIT_ORDERS_PER_SECOND=100
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
